# Server Configuration
VOICESHIELD_HOST=127.0.0.1
VOICESHIELD_PORT=8000
VOICESHIELD_LOG_LEVEL=INFO

# Hardware & Acceleration (mps, cpu)
VOICESHIELD_DEVICE=mps
VOICESHIELD_FALLBACK_TO_CPU=true

# DSP & Gating Thresholds
VOICESHIELD_SAMPLE_RATE=16000
VOICESHIELD_WINDOW_SECONDS=4.0
VOICESHIELD_HOP_SECONDS=1.0
VOICESHIELD_MIN_SPEECH_SECONDS=0.8
VOICESHIELD_ENERGY_THRESHOLD=0.015

# Model & Inference Settings
VOICESHIELD_MODEL_CHECKPOINT=
VOICESHIELD_TEMPERATURE=1.0

# CORS & Frontend Origins
VOICESHIELD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
